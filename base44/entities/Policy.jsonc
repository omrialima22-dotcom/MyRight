{
  "name": "Policy",
  "type": "object",
  "properties": {
    "insurance_company": {
      "type": "string",
      "title": "\u05d7\u05d1\u05e8\u05ea \u05d1\u05d9\u05d8\u05d5\u05d7",
      "description": "\u05e9\u05dd \u05d7\u05d1\u05e8\u05ea \u05d4\u05d1\u05d9\u05d8\u05d5\u05d7"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "health",
        "life",
        "car",
        "home",
        "travel",
        "disability",
        "other"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d1\u05d9\u05d8\u05d5\u05d7",
      "default": "health"
    },
    "policy_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e4\u05d5\u05dc\u05d9\u05e1\u05d4"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e4\u05d5\u05dc\u05d9\u05e1\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05e4\u05d5\u05dc\u05d9\u05e1\u05d4"
    },
    "coverage_amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd \u05db\u05d9\u05e1\u05d5\u05d9"
    },
    "monthly_premium": {
      "type": "number",
      "title": "\u05e4\u05e8\u05de\u05d9\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05ea"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "file_url": {
      "type": "string",
      "title": "\u05e7\u05d5\u05d1\u05e5 \u05d4\u05e4\u05d5\u05dc\u05d9\u05e1\u05d4"
    },
    "analysis": {
      "type": "string",
      "title": "\u05e0\u05d9\u05ea\u05d5\u05d7 AI \u05e9\u05dc \u05d4\u05e4\u05d5\u05dc\u05d9\u05e1\u05d4"
    }
  },
  "required": [
    "insurance_company",
    "policy_type"
  ]
}